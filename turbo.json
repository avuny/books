{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "VITE_API_URL",
    "NODE_ENV",
    "DATABASE_URL",
    "ACCESS_TOKEN_SECRET",
    "ACCESS_TOKEN_TTL",
    "REFRESH_TOKEN_TTL",
    "SESSION_ABSOLUTE_TTL",
    "VERIFICATION_TOKEN_SECRET",
    "VERIFICATION_TOKEN_TTL",
    "BCRYPT_ROUNDS",
    "OTP_SECRET",
    "OTP_TTL",
    "OTP_MAX_ATTEMPTS",
    "OTP_RESEND_COOLDOWN",
    "OTP_MAX_SENDS_PER_HOUR",
    "OTP_MAX_SENDS_PER_IP_PER_HOUR",
    "SIGNIN_MAX_FAILURES_PER_IDENTIFIER",
    "SIGNIN_MAX_FAILURES_PER_IP",
    "SIGNIN_THROTTLE_WINDOW",
    "COOKIE_SAMESITE",
    "COOKIE_DOMAIN",
    "CORS_ORIGINS",
    "TRUSTED_PROXY_IP_HEADER",
    "BACKGROUND_RUNNER",
    "AVATAR_MAX_BYTES",
    "STORAGE_ENDPOINT",
    "STORAGE_BUCKET",
    "STORAGE_ACCESS_KEY",
    "STORAGE_SECRET_KEY",
    "STORAGE_PUBLIC_BASE_URL",
    "EMAIL_HOST",
    "EMAIL_PORT",
    "EMAIL_USER",
    "EMAIL_PASS",
    "EMAIL_FROM",
    "WHATSAPP_API_URL",
    "WHATSAPP_API_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "AUDIT_RETENTION_DAYS",
    "AUDIT_HMAC_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "deploy": { "dependsOn": ["^build"], "cache": false },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

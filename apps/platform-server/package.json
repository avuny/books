{
  "name": "@avuny/platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy --minify",
    "deploy:dry": "wrangler deploy --dry-run --minify --outdir dist",
    "typecheck": "tsc --noEmit",
    "build": "pnpm openapi:generate && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "docker compose -f ../server/docker-compose.test.yml up -d --wait && vitest run --project integration",
    "test:int:raw": "vitest run --project integration",
    "openapi:generate": "tsx ./scripts/generate-openapi.ts",
    "clean:build": "rm -rf dist tsconfig.build.tsbuildinfo .turbo"
  },
  "dependencies": {
    "@avuny/contracts": "workspace:*",
    "@avuny/db": "workspace:*",
    "@avuny/hono": "workspace:*",
    "@avuny/logger": "workspace:*",
    "@avuny/utils": "workspace:*",
    "@avuny/zod": "workspace:*",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^1.1.5",
    "dotenv": "^17.4.2",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "eslint": "^9.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.3",
    "wrangler": "^4.0.0"
  }
}

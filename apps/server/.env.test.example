# Defaults for `pnpm test:int` and the web e2e run. Works as-is; to override, copy to .env.test (git-ignored).
# Precedence: shell/CI env > .env.test > this file. The app never reads .env during these runs.
#
# DEDICATED TEST DATABASE ONLY. The suite DROPS and recreates the public schema on every run.
# Local: `docker compose -f apps/server/docker-compose.test.yml up -d --wait` (repo root), then:
TEST_DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/avuny_test
# Neon test branch instead: put these two lines in .env.test (never in this file):
#   TEST_DATABASE_URL=<the branch's connection string>
#   TEST_DB_ALLOW_REMOTE=1

ACCESS_TOKEN_SECRET=test-access-token-secret-0123456789abcdef
VERIFICATION_TOKEN_SECRET=test-verification-token-secret-0123456789
OTP_SECRET=test-otp-secret-0123456789abcdef-0123456789
AUDIT_HMAC_SECRET=test-audit-hmac-secret-0123456789abcdef

# Required by the config schema; never used because MESSAGE_SENDER_MODE=capture (set by the harness).
RESEND_API_KEY=re_test_unused
EMAIL_FROM=test@example.com

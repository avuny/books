{
  "name": "@avuny/books-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:dry": "wrangler deploy --dry-run --minify --outdir dist",
    "typecheck": "tsc --noEmit",
    "dev:node": "concurrently \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsx watch src/node-server.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "api:extract": "api-extractor run --local",
    "api:docs": "api-documenter markdown -i temp -o docs",
    "clean:build": "rm -rf dist tsconfig.build.tsbuildinfo .turbo",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "pnpm clean:modules && pnpm clean:build",
    "openapi:generate": "tsx ./scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@avuny/contracts": "workspace:*",
    "@avuny/db": "workspace:*",
    "@avuny/hono": "workspace:*",
    "@avuny/logger": "workspace:*",
    "@avuny/utils": "workspace:*",
    "@avuny/zod": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/structured-logger": "^0.1.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^1.1.5",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.10.7",
    "i18next": "^26.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "orval": "^7.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qs": "^6.14.1",
    "resend": "^6.34.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qs": "^6.14.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.28.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.3",
    "wrangler": "^4.0.0",
    "zod": "^4.0.5"
  }
}

{
  "name": "@avuny/books-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@avuny/contracts": "workspace:*",
    "@avuny/i18n": "workspace:*",
    "@avuny/zod": "workspace:*",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^8.21.3",
    "@workspace/ui": "workspace:*",
    "axios": "^1.12.2",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "i18next-icu": "^2.4.4",
    "input-otp": "^1.5.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.12",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "zod": "link:@hookform/resolvers/zod"

          "value": "(\"user_identifiers\".\"type\" = 'email' and \"user_identifiers\".\"value\" ~ '^[^@[:space:]]+@[^@[:space:]]+[.][^@[:space:]]+$') or (\"user_identifiers\".\"type\" = 'phone' and \"user_identifiers\".\"value\" ~ '^[+][1-9][0-9]{6,14}$') or (\"user_identifiers\".\"type\" = 'username' and \"user_identifiers\".\"value\" !~ '^[^@[:space:]]+@[^@[:space:]]+[.][^@[:space:]]+$' and \"user_identifiers\".\"value\" !~ '^[+][1-9][0-9]{6,14}$' and \"user_identifiers\".\"value\" !~ '[[:space:]]')"
        },
        "user_identifiers_verified_chk": {
          "name": "user_identifiers_verified_chk",
          "value": "\"user_identifiers\".\"type\" = 'username' or \"user_identifiers\".\"verified_at\" is not null"
        }
      },
      "isRLSEnabled": false
    }

{
  "name": "@avuny/hono",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./request-language": "./src/request-language.ts"
  },
  "author": {
    "name": "Khaled Eleskandrany",
    "email": "khaledeskandrany@gmail.com"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "api:extract": "api-extractor run --local",
    "api:docs": "api-documenter markdown -i temp -o docs",
    "clean:build": "rm -rf dist tsconfig.build.tsbuildinfo .turbo",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "pnpm clean:modules && pnpm clean:build"
  },
  "dependencies": {
    "@avuny/i18n": "workspace:*",
    "@avuny/logger": "workspace:*",
    "@avuny/utils": "workspace:*",
    "@avuny/zod": "workspace:*",
    "@hono/zod-openapi": "^1.1.5",
    "hono": "^4.13.13",
    "qs": "^6.14.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/node": "^24",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.3",
    "eslint": "^9.28.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3"
  }
}